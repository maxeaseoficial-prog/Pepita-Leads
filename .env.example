# Obrigatório para buscas reais
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Quando definido, o Supabase tem prioridade sobre DATABASE_URL.
SUPABASE_DATABASE_URL=

# Base CNPJ/RFB dedicada. Recomendado manter separada do banco operacional.
# Quando vazio, a Pepita usa o banco operacional apenas por compatibilidade.
RFB_DATABASE_URL=
RFB_DB_SCHEMA=rfb

# Autenticação no navegador (chave pública/publishable; nunca use service_role aqui)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: habilita website / filtro sem site / Instagram via website oficial
GOOGLE_PLACES_API_KEY=
OPEN_CNPJ_BIGQUERY_ENABLED=false
OPENSTREETMAP_OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
OPEN_CNPJ_BIGQUERY_TABLE=opencnpj-bigquery.public.receita
OPEN_CNPJ_BIGQUERY_MAX_BYTES=53687091200
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=US
GOOGLE_CLOUD_CREDENTIALS=

# Proteção simples para jobs administrativos, caso você crie endpoints internos
ADMIN_SECRET=

# Stripe — deixe vazio até criar os produtos/preços no painel da Stripe.
# A cobrança só fica pronta quando SECRET_KEY + WEBHOOK_SECRET + PRICE IDs estiverem definidos.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_UNLIMITED=
