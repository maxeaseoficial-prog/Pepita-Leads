# Obrigatório para buscas reais
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Quando definido, o Supabase tem prioridade sobre DATABASE_URL.
SUPABASE_DATABASE_URL=

# Autenticação no navegador (chave pública/publishable; nunca use service_role aqui)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: habilita website / filtro sem site / Instagram via website oficial
GOOGLE_PLACES_API_KEY=

# Proteção simples para jobs administrativos, caso você crie endpoints internos
ADMIN_SECRET=
