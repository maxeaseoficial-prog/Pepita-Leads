  "narrative": {
    "northStar": "Sala de controle comercial Pepita",
    "overview": "Pepita mantém a identidade existente em grafite, preto e ouro. O chat é o núcleo da prospecção, os resultados têm superfície própria e o dossiê concentra os detalhes da empresa. O CRM prolonga esse trabalho com colunas legíveis e controles familiares, dentro da mesma navegação.\n\nA interface é compacta, de texto primeiro, com superfícies delimitadas e ícones SVG autorais. A personagem pixel art continua como identidade no cabeçalho e apoio a estados e transições; no CRM aparece no erro de carregamento e no convite de importação dos resultados, sem ocupar os cartões operacionais.",
    "keyCharacteristics": [
      "Grafite e preto como base; ouro nas ações e seleções.",
      "Navegação persistente e áreas de trabalho com rolagem própria.",
      "Hierarquia compacta, bordas discretas e profundidade concentrada em sobreposições.",
      "Texto direto em português e mascote em apoio ao estado."
    ],
    "rules": [
      {
        "name": "The Ouro de Ação Rule",
        "body": "O ouro distingue ação, seleção e foco; as superfícies de trabalho continuam escuras.",
        "section": "colors"
      },
      {
        "name": "The Rolagem Contida Rule",
        "body": "O quadro pode rolar horizontalmente dentro de sua área; a estrutura do produto permanece dentro da viewport.",
        "section": "layout"
      },
      {
        "name": "The Plano de Trabalho Rule",
        "body": "Bordas e tom estruturam os cartões do CRM; a elevação forte acompanha uma sobreposição ou arraste.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preservar grafite, preto e ouro e a personagem pixel art existente.",
      "**Do** usar texto direto em português, ícones SVG e ações de criação nos vazios.",
      "**Do** manter a rolagem horizontal do Kanban dentro do quadro.",
      "**Do** conservar foco visível e redução de movimento nas interações do CRM."
    ],
    "donts": [
      "**Don't** substituir a identidade por uma aparência genérica de “AI SaaS”.",
      "**Don't** usar emojis aleatórios como ícones da interface.",
      "**Don't** preencher o CRM vazio com empresas ou atividades inventadas.",
      "**Don't** transformar o mascote em decoração repetida dentro dos cartões."
    ]
  }
}
